rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to episodes (for the website)
    match /episodes/{episodeId} {
      allow read: if true;
      // Only allow users with the admin custom claim to write
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Allow public read access to articles, admin write
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
